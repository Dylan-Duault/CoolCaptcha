# CoolCaptcha Terminal Commands Configuration
# Copy this file to .env and customize the commands for your use case

# Windows Command (PowerShell/CMD)
CAPTCHA_COMMAND_WINDOWS=start https://customrickroll.github.io/

# macOS Command (Terminal)
CAPTCHA_COMMAND_MAC=open https://customrickroll.github.io/

# Linux Command (Terminal)
CAPTCHA_COMMAND_LINUX=xdg-open https://customrickroll.github.io/

# Example production commands:
# CAPTCHA_COMMAND_WINDOWS=powershell -Command "Invoke-WebRequest -Uri 'https://api.example.com/verify/token123'"
# CAPTCHA_COMMAND_MAC=curl "https://api.example.com/verify/token123"
# CAPTCHA_COMMAND_LINUX=wget -qO- "https://api.example.com/verify/token123"